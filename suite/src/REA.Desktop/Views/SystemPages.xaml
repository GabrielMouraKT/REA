<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:REA.Desktop.ViewModels">

    <!-- Tabela de ferramentas reutilizada no Dashboard e em Settings > Tools -->
    <DataTemplate x:Key="ToolsGrid">
        <DataGrid ItemsSource="{Binding}" RowHeight="NaN">
            <DataGrid.Resources>
                <Style x:Key="Wrap" TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="Margin" Value="0,8"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ferramenta" Binding="{Binding Name}" Width="130" ElementStyle="{StaticResource Wrap}"/>
                <DataGridTemplateColumn Header="Situação" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Available}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="*" ElementStyle="{StaticResource Wrap}"/>
                <DataGridTextColumn Header="Para que serve / como instalar" Binding="{Binding Requirement}" Width="2*" ElementStyle="{StaticResource Wrap}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DataTemplate>

    <!-- ================= DASHBOARD ================= -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <ScrollViewer>
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
                        <Button Content="+ Novo projeto" Margin="8,0,0,0" Command="{Binding NewProjectCommand}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Text="Indicadores lidos do banco local. Binários, mensagens e opcodes aparecerão quando os módulos das fases 3+ existirem."/>
                </DockPanel>
                <ProgressBar Style="{StaticResource LoadingBar}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                <UniformGrid Columns="4" Margin="-6,0,-6,0">
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Capturas" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding Captures}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Pacotes analisados" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding PacketsAnalyzed}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Fluxos TCP" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding TcpStreams}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Módulos implementados" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding Modules}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Columns="4" Margin="-6,0,-6,0">
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Projetos ativos" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding ActiveProjects}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Projetos arquivados" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding ArchivedProjects}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Ambientes" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding Environments}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="Ferramentas externas" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding ToolsSummary}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Atividades recentes" Style="{StaticResource H2}"/>
                            <TextBlock Text="Nenhuma atividade ainda. Crie um projeto para começar."
                                       Style="{StaticResource MutedText}"
                                       Visibility="{Binding HasNoActivity, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding Activity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0">
                                                    <Run Text="{Binding When, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Operator, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Status das integrações" Style="{StaticResource H2}"/>
                            <ContentControl Content="{Binding Tools}" ContentTemplate="{StaticResource ToolsGrid}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ================= ATIVIDADES ================= -->
    <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Mostrar as últimas" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding Take}" Width="80"/>
                <Button Content="Atualizar" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding LoadCommand}"/>
            </StackPanel>
            <ProgressBar DockPanel.Dock="Top" Style="{StaticResource LoadingBar}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" RowHeight="NaN">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Quando" Binding="{Binding When}" Width="150"/>
                            <DataGridTextColumn Header="Operador" Binding="{Binding Operator}" Width="170"/>
                            <DataGridTextColumn Header="Ação" Binding="{Binding Action}" Width="150"/>
                            <DataGridTemplateColumn Header="Resumo e detalhes" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8">
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"
                                                       Visibility="{Binding Details, Converter={StaticResource NullToCollapsed}}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Nenhuma atividade registrada." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ================= BANCO ================= -->
    <DataTemplate DataType="{x:Type vm:DatabaseViewModel}">
        <Border Style="{StaticResource Card}" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Banco SQLite local" Style="{StaticResource H2}"/>
                <TextBlock Text="Arquivo" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Text="Tamanho" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Size}"/>
                <TextBlock Text="Pasta de dados (troque com a variável REA_HOME)" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding DataRoot}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Text="Migrações aplicadas" Style="{StaticResource FieldLabel}"/>
                <ItemsControl ItemsSource="{Binding Applied}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Há migrações pendentes. Reinicie o aplicativo para aplicá-las." Foreground="{StaticResource Warning}"
                           Margin="0,10,0,0" Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Abrir pasta de dados" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Margin="0,16,0,0" Command="{Binding OpenFolderCommand}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================= FERRAMENTAS ================= -->
    <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Detectar novamente" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                           Text="Cada ferramenta é localizada no disco e executada para confirmar a versão. Nada é instalado automaticamente."/>
            </DockPanel>
            <ProgressBar DockPanel.Dock="Top" Style="{StaticResource LoadingBar}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                <ContentControl Content="{Binding Items}" ContentTemplate="{StaticResource ToolsGrid}"/>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ================= BACKUP ================= -->
    <DataTemplate DataType="{x:Type vm:BackupViewModel}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Abrir pasta" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}"/>
                    <Button Content="Criar backup agora" Margin="8,0,0,0" Command="{Binding CreateCommand}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                           Text="Backup automático a cada 24 h (últimos 14 mantidos). Antes de restaurar, o estado atual é salvo."/>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding When}" Width="160"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Reason}" Width="150"/>
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="100"/>
                            <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTemplateColumn Header="Ações" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Restaurar" Style="{StaticResource LinkButton}"
                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Nenhum backup ainda. Clique em &quot;Criar backup agora&quot;." Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
