<Window x:Class="REA.Desktop.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="22">
        <TextBlock x:Name="TitleText" Style="{StaticResource H2}"/>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource Text}"/>
        <TextBox x:Name="InputBox" Margin="0,12,0,0" MaxLength="120" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnCancel"/>
            <Button x:Name="ConfirmButton" Margin="8,0,0,0" IsDefault="True" Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</Window>
