<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:REA.Desktop.ViewModels">

    <Style x:Key="MonoBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="AcceptsReturn" Value="True"/>
    </Style>

    <Style x:Key="WarningBanner" TargetType="Border">
        <Setter Property="Background" Value="#2A2210"/>
        <Setter Property="BorderBrush" Value="#5C4613"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Seletor de captura comum ao Packet Inspector e ao TCP Stream Explorer -->
    <DataTemplate x:Key="CaptureSelector">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Captura" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding CaptureInfo}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                <ComboBox ItemsSource="{Binding CaptureOptions}" SelectedItem="{Binding SelectedCapture}" DisplayMemberPath="Label" MaxWidth="720" HorizontalAlignment="Left"/>
            </DockPanel>
            <Border Style="{StaticResource WarningBanner}" Visibility="{Binding FileWarning, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding FileWarning}" Foreground="{StaticResource Warning}" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource WarningBanner}" Visibility="{Binding HasNoCaptures, Converter={StaticResource BoolToVis}}">
                <TextBlock Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                           Text="Nenhuma captura ainda. Faça uma em Research › Network Capture ou importe um PCAP/PCAPNG em Evidence › Captures."/>
            </Border>
            <ProgressBar Style="{StaticResource LoadingBar}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ================= NETWORK CAPTURE ================= -->
    <DataTemplate DataType="{x:Type vm:NetworkCaptureViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer>
                <StackPanel>
                    <Border Style="{StaticResource WarningBanner}" Visibility="{Binding UnavailableReason, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding UnavailableReason}" Foreground="{StaticResource Warning}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel IsEnabled="{Binding IsIdle}">
                            <TextBlock Text="Nova captura" Style="{StaticResource H2}"/>
                            <TextBlock Text="Projeto *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name"/>
                            <TextBlock Text="Ambiente" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" DisplayMemberPath="Label"/>
                            <TextBlock Text="Nome da captura *" Style="{StaticResource FieldLabel}"/>
                            <TextBox AutomationProperties.AutomationId="CaptureName" Text="{Binding CaptureName, UpdateSourceTrigger=PropertyChanged}" MaxLength="160"/>
                            <DockPanel Margin="0,10,0,4">
                                <Button DockPanel.Dock="Right" Content="Atualizar" Style="{StaticResource LinkButton}" Command="{Binding RefreshInterfacesCommand}"/>
                                <TextBlock Text="Interface de rede *" Style="{StaticResource FieldLabel}" Margin="0"/>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" DisplayMemberPath="Label"/>
                            <TextBlock Text="{Binding SelectedInterface.Addresses}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
                            <DockPanel Margin="0,10,0,4">
                                <Button DockPanel.Dock="Right" Content="Exemplo" Style="{StaticResource LinkButton}" Command="{Binding UseLoopbackExampleCommand}"
                                        ToolTip="Preenche com tcp port 7000"/>
                                <TextBlock Text="Filtro de captura (BPF, opcional)" Style="{StaticResource FieldLabel}" Margin="0"/>
                            </DockPanel>
                            <TextBox AutomationProperties.AutomationId="BpfFilter" Text="{Binding BpfFilter, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                     ToolTip="Ex.: tcp port 7000 · host 127.0.0.1 · udp and port 53"/>
                            <TextBlock Text="Limites (vazio = sem limite)" Style="{StaticResource FieldLabel}"/>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Pacotes" Style="{StaticResource MutedText}" FontSize="11"/>
                                    <TextBox Text="{Binding MaxPackets, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="3,0">
                                    <TextBlock Text="Tamanho (MB)" Style="{StaticResource MutedText}" FontSize="11"/>
                                    <TextBox Text="{Binding MaxMegabytes, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Tempo (s)" Style="{StaticResource MutedText}" FontSize="11"/>
                                    <TextBox AutomationProperties.AutomationId="MaxSeconds" Text="{Binding MaxSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding FormError}" Style="{StaticResource ErrorText}"
                                       Visibility="{Binding FormError, Converter={StaticResource NullToCollapsed}}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Iniciar captura" Command="{Binding StartCommand}" IsEnabled="{Binding IsAvailable}"/>
                        <Button Content="Parar" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding StopCommand}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,0"
                               Text="Captura passiva: nada é enviado à rede. Capture apenas tráfego seu ou de ambientes em que você tem autorização. Para tráfego entre programas no mesmo PC, use a interface Loopback."/>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" CornerRadius="4" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                            <Setter Property="Background" Value="#3A1414"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontWeight="SemiBold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Parado"/>
                                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                <Setter Property="Text" Value="● Capturando"/>
                                                <Setter Property="Foreground" Value="#F87171"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding StatsText}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12"
                        Visibility="{Binding LastResult, Converter={StaticResource NullToCollapsed}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Abrir no Packet Inspector" Command="{Binding OpenInInspectorCommand}"/>
                            <Button Content="Ver fluxos TCP" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding OpenStreamsCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <ListBox ItemsSource="{Binding Packets}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12" VirtualizingPanel.IsVirtualizing="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Number, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                                        <Run Text="  "/><Run Text="{Binding Length, Mode=OneWay}"/><Run Text=" B  "/>
                                        <Run Text="{Binding Summary, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Os pacotes aparecem aqui durante a captura (últimos 1000). O arquivo guarda todos."
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoPackets, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DataTemplate>

    <!-- ================= CAPTURAS (EVIDÊNCIAS) ================= -->
    <DataTemplate DataType="{x:Type vm:CapturesViewModel}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Ambiente" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding ImportEnvironment}" DisplayMemberPath="Label" Width="170"
                              IsEnabled="{Binding CanImport}"/>
                    <Button Content="Importar PCAP/PCAPNG" Margin="8,0,0,0" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}"
                            ToolTip="Escolha um projeto no filtro para importar. O original é copiado e nunca alterado."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Projeto" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding ProjectOptions}" SelectedItem="{Binding ProjectFilter}" DisplayMemberPath="Label" Width="230"/>
                    <TextBlock Text="Buscar" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <TextBox Width="200" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome ou SHA-256 (Enter)">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ApplySearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </DockPanel>
            <ProgressBar DockPanel.Dock="Top" Style="{StaticResource LoadingBar}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <!-- Ações sobre a captura selecionada -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" IsEnabled="{Binding HasSelection}">
                <TextBlock Text="Captura selecionada:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="Abrir no Packet Inspector" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedRow}"/>
                <Button Content="Fluxos TCP" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding StreamsCommand}" CommandParameter="{Binding SelectedRow}"/>
                <Button Content="Detalhes" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding DetailsCommand}" CommandParameter="{Binding SelectedRow}"/>
                <Button Content="Validar com TShark" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding CrossCheckCommand}" CommandParameter="{Binding SelectedRow}"/>
                <Button Content="Reanalisar" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding ReanalyzeCommand}" CommandParameter="{Binding SelectedRow}"/>
                <Button Content="Exportar cópia" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding ExportCommand}" CommandParameter="{Binding SelectedRow}"/>
                <Button Content="Mostrar na pasta" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding ShowInFolderCommand}" CommandParameter="{Binding SelectedRow}"/>
            </WrapPanel>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" MaxHeight="260"
                    Visibility="{Binding Report, Converter={StaticResource NullToCollapsed}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Content="Fechar" Style="{StaticResource LinkButton}" Command="{Binding CloseReportCommand}"/>
                        <TextBlock Text="{Binding ReportTitle}" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <TextBox Text="{Binding Report, Mode=OneWay}" Style="{StaticResource MonoBox}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Itens por página" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Width="80"/>
                    <Button Content="Anterior" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Command="{Binding PreviousPageCommand}"/>
                    <Button Content="Próxima" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding NextPageCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding PageText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRow}">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedRow}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Captura" Binding="{Binding Name}" Width="2*" MinWidth="160"/>
                            <DataGridTextColumn Header="Projeto" Binding="{Binding Project}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Ambiente" Binding="{Binding Environment}" Width="*" MinWidth="90"/>
                            <DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="80"/>
                            <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Pacotes" Binding="{Binding Packets, StringFormat=N0}" Width="80"/>
                            <DataGridTextColumn Header="Fluxos TCP" Binding="{Binding Streams}" Width="85"/>
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="80"/>
                            <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha}" Width="120"/>
                            <DataGridTextColumn Header="Criada" Binding="{Binding Created}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Nenhuma captura" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center"
                                   Text="Capturas feitas em Research › Network Capture aparecem aqui. Para importar um arquivo, escolha um projeto no filtro e clique em Importar PCAP/PCAPNG."/>
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>
    </DataTemplate>

    <!-- ================= PACKET INSPECTOR ================= -->
    <DataTemplate DataType="{x:Type vm:PacketInspectorViewModel}">
        <DockPanel>
            <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource CaptureSelector}" Focusable="False"/>

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Protocolo" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" DisplayMemberPath="Label" Width="120"/>
                <TextBlock Text="Endereço" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="140" ToolTip="IP de origem ou destino, ex.: 127.0.0.1"/>
                <TextBlock Text="Porta" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <TextBlock Text="Texto" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="140" ToolTip="Procura no resumo e nos bytes do pacote (ASCII, sem diferenciar maiúsculas)">
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ApplyFilterCommand}"/></TextBox.InputBindings>
                </TextBox>
                <CheckBox Content="Só com dados" IsChecked="{Binding OnlyPayload}" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Content="Aplicar filtro" Margin="12,0,0,0" Command="{Binding ApplyFilterCommand}"/>
                <Button Content="Limpar" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding ClearFilterCommand}"/>
                <Button Content="Exportar CSV" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding ExportCsvCommand}"/>
            </WrapPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding FilterError}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                       Visibility="{Binding FilterError, Converter={StaticResource NullToCollapsed}}"/>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Itens por página" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Width="80"/>
                    <Button Content="Anterior" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Command="{Binding PreviousPageCommand}"/>
                    <Button Content="Próxima" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding NextPageCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding PageText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            </DockPanel>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="0">
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedPacket}" FontFamily="{StaticResource MonoFont}" FontSize="12" RowHeight="28"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nº" Binding="{Binding Number}" Width="70"/>
                            <DataGridTextColumn Header="Horário" Binding="{Binding Time}" Width="140"/>
                            <DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="170"/>
                            <DataGridTextColumn Header="Destino" Binding="{Binding Destination}" Width="170"/>
                            <DataGridTextColumn Header="Protocolo" Binding="{Binding Protocol}" Width="80"/>
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding Length}" Width="70"/>
                            <DataGridTextColumn Header="Flags" Binding="{Binding Flags}" Width="110"/>
                            <DataGridTextColumn Header="Informação" Binding="{Binding Info}" Width="*" MinWidth="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Layers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource AccentHover}"/>
                                            <ItemsControl ItemsSource="{Binding Fields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="10,2,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                        <TabControl Background="Transparent" BorderThickness="0">
                            <TabItem Header="Pacote (hex + ASCII)">
                                <TextBox Text="{Binding Hex, Mode=OneWay}" Style="{StaticResource MonoBox}"/>
                            </TabItem>
                            <TabItem Header="Dados da aplicação">
                                <TextBox Text="{Binding PayloadHex, Mode=OneWay}" Style="{StaticResource MonoBox}"/>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <!-- ================= TCP STREAM EXPLORER ================= -->
    <DataTemplate DataType="{x:Type vm:TcpStreamsViewModel}">
        <DockPanel>
            <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource CaptureSelector}" Focusable="False"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.8*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="0">
                    <DataGrid ItemsSource="{Binding Streams}" SelectedItem="{Binding SelectedStream}" RowHeight="NaN">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nº" Binding="{Binding Index}" Width="45"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Client}" Width="170"/>
                            <DataGridTextColumn Header="Servidor" Binding="{Binding Server}" Width="170"/>
                            <DataGridTextColumn Header="Pacotes" Binding="{Binding Packets}" Width="70"/>
                            <DataGridTextColumn Header="Cliente→Servidor" Binding="{Binding ClientBytes}" Width="120"/>
                            <DataGridTextColumn Header="Servidor→Cliente" Binding="{Binding ServerBytes}" Width="120"/>
                            <DataGridTextColumn Header="Retransm." Binding="{Binding Retransmissions}" Width="80"/>
                            <DataGridTextColumn Header="Duração" Binding="{Binding Duration}" Width="100"/>
                            <DataGridTemplateColumn Header="Reconstrução" Width="*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIncomplete}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Exportar bytes" Style="{StaticResource SecondaryButton}" Command="{Binding ExportBytesCommand}"/>
                                <TextBlock Text="Direção" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}" DisplayMemberPath="Label" Width="170" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding StreamStats}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,8"/>
                            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Gaps}" Margin="0,0,0,8"
                                          Visibility="{Binding HasGaps, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat=Lacuna: {0}}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TabControl Background="Transparent" BorderThickness="0">
                                <TabItem Header="Hex + ASCII">
                                    <TextBox Text="{Binding Hex, Mode=OneWay}" Style="{StaticResource MonoBox}"/>
                                </TabItem>
                                <TabItem Header="Somente texto">
                                    <TextBox Text="{Binding Ascii, Mode=OneWay}" Style="{StaticResource MonoBox}" TextWrapping="Wrap"/>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Linha do tempo" Style="{StaticResource H2}" Margin="14,12,14,4"/>
                            <DataGrid ItemsSource="{Binding Timeline}" FontFamily="{StaticResource MonoFont}" FontSize="12" RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Quadro" Binding="{Binding Frame}" Width="60"/>
                                    <DataGridTextColumn Header="Horário" Binding="{Binding Time}" Width="125"/>
                                    <DataGridTextColumn Header="Sentido" Binding="{Binding Direction}" Width="70"/>
                                    <DataGridTextColumn Header="Flags" Binding="{Binding Flags}" Width="110"/>
                                    <DataGridTextColumn Header="Dados" Binding="{Binding Length}" Width="60"/>
                                    <DataGridTextColumn Header="Seq rel." Binding="{Binding Sequence}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
