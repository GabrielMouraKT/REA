<Window x:Class="REA.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:REA.Desktop.ViewModels"
        xmlns:svc="clr-namespace:REA.Desktop.Services"
        Title="REA Advanced Suite" Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,18,18,14">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource Accent}">
                        <TextBlock Text="R" FontWeight="Bold" FontSize="15" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="REA" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Advanced Suite" Foreground="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="18,10,18,14" FontSize="11" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Text="Itens com F2…F9 estão planejados para fases futuras."/>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Entries}" Margin="10,0,10,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavEntry}">
                                <Grid>
                                    <TextBlock Text="{Binding Header}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Muted}" Margin="8,16,0,6"
                                               Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}"/>
                                    <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsHeader, Converter={StaticResource InverseBoolToVis}}"
                                            HorizontalContentAlignment="Stretch" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                            ToolTip="{Binding Item.Description}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" CornerRadius="6" Padding="10,7" Background="Transparent" Margin="0,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="5,1" Background="{StaticResource Surface2}"
                                                    Visibility="{Binding IsPlanned, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource Muted}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlanned}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Padding="28,18,28,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentSection}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource H1}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <ContentControl Content="{Binding CurrentPage}" Margin="28,20,28,20" Focusable="False"/>
        </DockPanel>

        <!-- Notificações -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Notifications.Items}" HorizontalAlignment="Right"
                      VerticalAlignment="Bottom" Margin="0,0,24,24" Width="380">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type svc:Notification}">
                    <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Fechar" Style="{StaticResource LinkButton}" VerticalAlignment="Top"
                                    Command="{Binding DataContext.Notifications.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
